    "/api/v1/analyses/{analysis_id}/sessions": {
      "get": {
        "tags": [
          "Analyses & Sessions"
        ],
        "summary": "Server-side cursor-based session filtering and sorting (sub-200ms p95 on 100k flows)",
        "description": "Cursor-paginated session search with indexed filtering.",
        "operationId": "list_analysis_sessions_api_v1_analyses__analysis_id__sessions_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque pagination cursor token",
              "title": "Cursor"
            },
            "description": "Opaque pagination cursor token"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "description": "Page item limit",
              "default": 50,
              "title": "Limit"
            },
            "description": "Page item limit"
          },
          {
            "name": "min_risk",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 100.0,
                  "minimum": 0.0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum risk score filter",
              "title": "Min Risk"
            },
            "description": "Minimum risk score filter"
          },
          {
            "name": "band",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Risk band filter: SECURE, ACCEPTABLE, WEAK, HIGH, CRITICAL",
              "title": "Band"
            },
            "description": "Risk band filter: SECURE, ACCEPTABLE, WEAK, HIGH, CRITICAL"
          },
          {
            "name": "protocol",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Mail protocol: SMTP, IMAP, POP3",
              "title": "Protocol"
            },
            "description": "Mail protocol: SMTP, IMAP, POP3"
          },
          {
            "name": "starttls_state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "STARTTLS state: S0_TCP_EST to S4_TLS_READY",
              "title": "Starttls State"
            },
            "description": "STARTTLS state: S0_TCP_EST to S4_TLS_READY"
          },
          {
            "name": "is_anomaly",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ML anomaly flag filter",
              "title": "Is Anomaly"
            },
            "description": "ML anomaly flag filter"
          },
          {
            "name": "ja3",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client JA3 hash filter",
              "title": "Ja3"
            },
            "description": "Client JA3 hash filter"
          },
          {
            "name": "sni",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Target SNI hostname substring",
              "title": "Sni"
            },
            "description": "Target SNI hostname substring"
          },
          {
            "name": "dst_ip",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Destination server IP address",
              "title": "Dst Ip"
            },
            "description": "Destination server IP address"
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(risk|anomaly|ts)$",
              "description": "Sort field: risk, anomaly, ts",
              "default": "risk",
              "title": "Sort By"
            },
            "description": "Sort field: risk, anomaly, ts"
          },
          {
            "name": "sort_order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(asc|desc)$",
              "description": "Sort order: asc or desc",
              "default": "desc",
              "title": "Sort Order"
            },
            "description": "Sort order: asc or desc"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CursorPaginatedSessions"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
