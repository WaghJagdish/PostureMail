{
  "openapi": "3.1.0",
  "info": {
    "title": "PECFF - Passive Email Cryptographic Forensics Framework",
    "description": "Passive network forensics and cryptographic analysis API for SMTP/IMAP/POP3 traffic. Implements pure deterministic NIST SP 800-57 risk scoring, JA3/JA4 TLS fingerprinting, unsupervised ML anomaly detection, and hostile-input hardened parsing.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/pcaps": {
      "post": {
        "tags": [
          "PCAP Ingestion"
        ],
        "summary": "Upload and ingest a PCAP/PCAPNG capture file with streaming SHA-256 hashing",
        "description": "Stream multipart upload directly to storage, compute SHA-256 in chunks, validate magic bytes.",
        "operationId": "upload_pcap_api_v1_pcaps_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_pcap_api_v1_pcaps_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PcapUploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
